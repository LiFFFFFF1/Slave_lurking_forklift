#include "myiic.h"



/* 私有宏定义*/

 
//IO方向设置
#define SDA_IN()  {GPIOB->CRH &= ~(0xF<<12);GPIOB->CRH |= (0x8<<12);}	    // PB11输入模式
#define SDA_OUT() {GPIOB->CRH &= ~(0xF<<12);GPIOB->CRH |= (0x3<<12);}       // PB11输出模式

//IO操作函数	 
#define IIC_SCL    PBout(10)                                                 // SCL
#define IIC_SDA    PBout(11)                                                 // SDA	 
#define READ_SDA   PBin(11)                                                  // 输入SDA 

/**************************************************************************************************************************
*
*@brief:   初始化模拟IIC
*@param:   
*@retval   None
**************************************************************************************************************************/

void Bsp_My_IIC_Init(void)
{			
    GPIO_InitTypeDef GPIO_InitStructure;

    RCC_APB2PeriphClockCmd(RCC_APB2Periph_GPIOB, ENABLE);//使能GPIOX端口时钟

    /* PB10-11  输出*/
    GPIO_InitStructure.GPIO_Pin = GPIO_Pin_10 | GPIO_Pin_11;//
    GPIO_InitStructure.GPIO_Mode = GPIO_Mode_Out_PP;    //推挽输出
    GPIO_InitStructure.GPIO_Speed = GPIO_Speed_50MHz;   //IO口速度为50MHz
    GPIO_Init(GPIOB, &GPIO_InitStructure);              //初始化PD端口

    IIC_SCL=1;
    IIC_SDA=1;
    
}

/**************************************************************************************************************************
*
*@brief:   产生IIC起始信号
*@param:   
*@retval   None
**************************************************************************************************************************/
void Bsp_My_IIC_Start(void)
{
	SDA_OUT();      //sda线输出
	IIC_SDA=1;	  	  
	IIC_SCL=1;
	delay_us(4);
 	IIC_SDA=0;      //START:when CLK is high,DATA change form high to low 
	delay_us(4);
	IIC_SCL=0;      //钳住I2C总线，准备发送或接收数据 
}	  


/**************************************************************************************************************************
*
*@brief:   产生IIC停止信号
*@param:   
*@retval   None
**************************************************************************************************************************/
void Bsp_My_IIC_Stop(void)
{
	SDA_OUT();      //sda线输出
	IIC_SCL=0;
	IIC_SDA=0;      //STOP:when CLK is high DATA change form low to high
 	delay_us(4);
	IIC_SCL=1; 
        delay_us(2);
	IIC_SDA=1;      //发送I2C总线结束信号
	delay_us(4);  
}



/**************************************************************************************************************************
*
*@brief:   等待应答信号到来
*@param:   
*@retval   1，接收应答失败
*          0，接收应答成功
**************************************************************************************************************************/
u8 Bsp_My_IIC_Wait_Ack(void)
{
	u8 ucErrTime=0;
	SDA_IN();               //SDA设置为输入  
	IIC_SDA=1;delay_us(1);	   
	IIC_SCL=1;delay_us(1);	 
	while(READ_SDA)
	{
		ucErrTime++;
		if(ucErrTime>250)
		{
			Bsp_My_IIC_Stop();
			return 1;
		}
	}
	IIC_SCL=0;//时钟输出0 	   
	return 0;  
} 


/**************************************************************************************************************************
*
*@brief:   产生ACK应答
*@param:   
*@retval  
**************************************************************************************************************************/
void Bsp_My_IIC_Ack(void)
{
	IIC_SCL=0;
	SDA_OUT();
	IIC_SDA=0;
	delay_us(2);
	IIC_SCL=1;
	delay_us(2);
	IIC_SCL=0;
}
	
/**************************************************************************************************************************
*
*@brief:   不产生ACK应答
*@param:   
*@retval  
**************************************************************************************************************************/
void Bsp_My_IIC_NAck(void)
{
	IIC_SCL=0;
	SDA_OUT();
	IIC_SDA=1;
	delay_us(2);
	IIC_SCL=1;
	delay_us(2);
	IIC_SCL=0;
}					 				     


/**************************************************************************************************************************
*
*@brief:   IIC发送一个字节
*@param:   1-有应答，0-无应答
*@retval  
**************************************************************************************************************************/
void Bsp_My_IIC_Send_Byte(u8 txd)
{                        
    u8 t;   
	SDA_OUT(); 	    
    IIC_SCL=0;//拉低时钟开始数据传输
    for(t=0;t<8;t++)
    {              
        IIC_SDA=(txd&0x80)>>7;
        txd<<=1; 	  
		delay_us(2);        //对TEA5767这三个延时都是必须的
		IIC_SCL=1;
		delay_us(2); 
		IIC_SCL=0;	
		delay_us(2);
    }
    //IIC_SDA =1;             // 2022-06-09   
} 	    
 

/**************************************************************************************************************************
*
*@brief:   IIC读一个字节
*@param:   ack=1时，发送ACK，ack=0，发送nACK   
*@retval  
**************************************************************************************************************************/
u8 Bsp_My_IIC_Read_Byte(unsigned char ack)
{
	unsigned char i,receive=0;
	SDA_IN();                                   //SDA设置为输入
    for(i=0;i<8;i++ )
	{
        IIC_SCL=0; 
        delay_us(2);
		IIC_SCL=1;
        receive<<=1;
        if(READ_SDA)receive++;   
		delay_us(1); 
    }					 
    if (!ack)
        Bsp_My_IIC_NAck();                     //发送nACK
    else
        Bsp_My_IIC_Ack();                      //发送ACK   
    return receive;
}


