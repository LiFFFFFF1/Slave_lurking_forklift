#define INPUT_ESTOP_SKIP   PBin(1)        //  IN4-------台车急停按键--常开接法



#define GET_LOW_BYTE(i)   ((u8)(i) ) 
#define GET_HIGH_BYTE(i)  ((u8)( (i)>>8 & 0x00ff ))

#define MAKE_SHORT(a, b)  ((u16) (a<<8 | b))
#define MAKE_INT(a,b,c,d) ((u32) (a<<24 | b<<16 | c<<8 | d))

